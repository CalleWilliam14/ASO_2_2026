# Archivo smb.conf gestionado por Ansible

[global]
   workgroup = WORKGROUP
   server string = Servidor Samba %v
   netbios name = {{ ansible_hostname }}
   security = user
   map to guest = Bad User
   dns proxy = no

# --- Recursos Compartidos ---
[{{ samba_share_name }}]
   comment = Carpeta compartida por Ansible
   path = {{ samba_share_path }}
   browseable = yes
   read only = no
   guest ok = no
   valid users = {{ samba_username }}
   create mask = 0770
   directory mask = 0770
